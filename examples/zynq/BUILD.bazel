load("//fpga:design.bzl", "fpga_clock_domain", "fpga_design", "fpga_ip", "fpga_ip_inst")
load("//fpga:rules.bzl", "fpga_flow", "fpga_project", "fpga_synthesis")

fpga_clock_domain(
    name = "main_clk",
    clock_frequency = "100MHz",
    clock_pin = "ps7_0/FCLK_CLK0",
    reset_pin = "ps7_0/FCLK_RESET0_N",
    reset_type = "active_low",
)

# One declaration of the IP, shared by both instances below.
fpga_ip(
    name = "crc_ip",
    clock_port = "s_axi_aclk",
    deps = ["//examples/zynq/ip/ip-crc/src:src"],
    entity_name = "crc_top_wrapper",
    generics = {"C_S_AXI_ADDR_WIDTH": "6"},
    inst_tcl = "//examples/zynq/ip/ip-crc/src:vivado_inst_crc.tcl",
    interfaces = {
        "s_axi": "slave",
        "S_AXI_LITE": "slave",
        "M_AXI*": "master",   # "M_AXI_MM2S"
    },
    reset_port = "s_axi_aresetn",
    tags = ["manual"],
)

fpga_ip_inst(
    name = "crc_0",
    clock_domain = ":main_clk",
    generics = {"C_S_AXI_ADDR_WIDTH": "7"},
    ip = ":crc_ip",
    memory_mapping = {
        "SEG_CRC": "0x43DB0000",
        "SEG_CRC_DMA": "0x43DC0000",
        "S2MM_DMA": "0x00000000",
    },
    ooc = False,
    tags = ["manual"],
)

fpga_ip_inst(
    name = "crc",
    clock_domain = ":main_clk",
    ip = ":crc_ip",
    memory_mapping = {
        "SEG_CRC": "0x43D90000",
        "SEG_CRC_DMA": "0x43D60000",
        "S2MM_DMA": "0x00000000",
    },
    ooc = False,
    tags = ["manual"],
)

fpga_design(
    name = "zynq_design",
    ips = [
        ":crc_0",
        ":crc",
    ],
    part = "xc7z010clg400-1",
    pre_bd_hook = ":ps.tcl",
    post_bd_hook = ":ps_master.tcl",
    top = "zynq_design_wrapper",
)

fpga_project(
    name = "zynq_project",
    design = ":zynq_design",
    part = "xc7z010clg400-1",
    top = "zynq_design_wrapper",
)

fpga_synthesis(
    name = "zynq_synthesis",
    part = "xc7z010clg400-1",
    project = ":zynq_project",
    top = "zynq_design_wrapper",
)

fpga_flow(
    name = "zynq_flow",
    design = ":zynq_design",
    max_threads = 2,
    part = "xc7z010clg400-1",
    top = "zynq_design_wrapper",
)